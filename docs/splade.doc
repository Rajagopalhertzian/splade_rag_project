### 7.2 Elasticsearch Integration

```json
// Index mapping for SPLADE vectors
{
  "mappings": {
    "properties": {
      "content": { "type": "text" },
      "splade_vector": {
        "type": "rank_features"
      },
      "metadata": { "type": "object" }
    }
  }
}
```

```python
from elasticsearch import Elasticsearch

class ElasticsearchSPLADEIndex:
    def __init__(self, es_url='http://localhost:9200',
                 index_name='splade_rag'):
        self.es = Elasticsearch([es_url])
        self.index_name = index_name
        self._create_index()

    def _create_index(self):
        mapping = {
            "mappings": {
                "properties": {
                    "content": {"type": "text"},
                    "splade_vector": {"type": "rank_features"},
                    "metadata": {"type": "object"}
                }
            }
        }
        if not self.es.indices.exists(index=self.index_name):
            self.es.indices.create(index=self.index_name, body=mapping)

    def add_documents(self, docs: List[Dict]):
        """docs = [{'id': ..., 'content': ..., 'splade_vec': {...}, 'metadata': ...}]"""
        actions = []
        for doc in docs:
            # Convert sparse dict to rank_features format
            rank_features = {
                str(token_id): weight
                for token_id, weight in doc['splade_vec'].items()
            }
            actions.append({
                "_index": self.index_name,
                "_id": doc['id'],
                "_source": {
                    "content": doc['content'],
                    "splade_vector": rank_features,
                    "metadata": doc.get('metadata', {})
                }
            })
        from elasticsearch.helpers import bulk
        bulk(self.es, actions)

    def search(self, query_vec: Dict[int, float], top_k: int = 10):
        # Build rank_feature query
        should_clauses = []
        for token_id, weight in query_vec.items():
            should_clauses.append({
                "rank_feature": {
                    "field": f"splade_vector.{token_id}",
                    "saturation": {
                        "pivot": 1.0
                    },
                    "boost": weight
                }
            })

        query = {
            "size": top_k,
            "query": {
                "bool": {"should": should_clauses, "minimum_should_match": 1}
            }
        }
        return self.es.search(index=self.index_name, body=query)
```

### 7.3 Hybrid Retrieval (SPLADE + Dense)

```python
class HybridRetriever:
    def __init__(self, splade_retriever, dense_retriever,
                 alpha: float = 0.5, fusion: str = 'rrf'):
        self.splade = splade_retriever
        self.dense = dense_retriever
        self.alpha = alpha  # Weight for score combination
        self.fusion = fusion  # 'rrf', 'weighted', 'linear'

    def retrieve(self, query: str, top_k: int = 10) -> List[Tuple[str, float]]:
        # Get results from both retrievers
        splade_results = self.splade.retrieve(query, top_k * 2)
        dense_results = self.dense.retrieve(query, top_k * 2)

        if self.fusion == 'rrf':
            return self._rrf_fusion(splade_results, dense_results, top_k)
        elif self.fusion == 'weighted':
            return self._weighted_fusion(splade_results, dense_results, top_k)
        else:
            return self._linear_fusion(splade_results, dense_results, top_k)

    def _rrf_fusion(self, results1, results2, top_k, k=60):
        """Reciprocal Rank Fusion"""
        scores = defaultdict(float)
        for rank, (doc_id, _) in enumerate(results1):
            scores[doc_id] += 1 / (k + rank + 1)
        for rank, (doc_id, _) in enumerate(results2):
            scores[doc_id] += 1 / (k + rank + 1)
        return heapq.nlargest(top_k, scores.items(), key=lambda x: x[1])
```

### 7.4 RAG Application Example

```python
from transformers import AutoModelForCausalLM, AutoTokenizer
import torch

class SPLADERAG:
    def __init__(self,
                 splade_model_path: str,
                 llm_model_name: str = 'microsoft/Phi-3-mini-4k-instruct',
                 index_path: str = None,
                 device: str = 'cuda'):

        # SPLADE components
        self.encoder = SPLADEEncoder(splade_model_path, device=device)
        self.index = SPLADEIndex.load(index_path) if index_path else SPLADEIndex()
        self.retriever = SPLADERetriever(self.index, self.encoder,
                                         self.encoder.tokenizer)

        # LLM for generation
        self.llm_tokenizer = AutoTokenizer.from_pretrained(llm_model_name)
        self.llm = AutoModelForCausalLM.from_pretrained(
            llm_model_name,
            torch_dtype=torch.float16,
            device_map='auto'
        )

    def answer(self, question: str, top_k: int = 5,
               max_new_tokens: int = 512) -> Dict:
        # Retrieve
        retrieved = self.retriever.retrieve(question, top_k=top_k)

        # Build context
        context_parts = []
        citations = []
        for i, (doc_id, score) in enumerate(retrieved):
            meta = self.index.doc_metadata.get(doc_id, {})
            content = meta.get('content', '')
            context_parts.append(f"[Doc {i+1}] {content}")
            citations.append({
                'doc_id': doc_id,
                'score': score,
                'metadata': meta
            })

        context = "\n\n".join(context_parts)

        # Generate answer
        prompt = f"""Answer the question based on the provided context.

Context:
{context}

Question: {question}

Answer:"""

        inputs = self.llm_tokenizer(prompt, return_tensors='pt').to(self.llm.device)
        with torch.no_grad():
            outputs = self.llm.generate(
                **inputs,
                max_new_tokens=max_new_tokens,
                temperature=0.3,
                do_sample=True,
                top_p=0.9
            )

        answer = self.llm_tokenizer.decode(
            outputs[0][inputs['input_ids'].shape[1]:],
            skip_special_tokens=True
        )

        return {
            'answer': answer.strip(),
            'citations': citations,
            'context_used': len(context_parts)
        }
```

