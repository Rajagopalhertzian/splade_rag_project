## 9. Best Practices

### 9.1 Data Preparation

```python
def preprocess_for_splade(text: str, max_length: int = 256) -> str:
    """Optimize text for SPLADE encoding"""
    # SPLADE works best with:
    # - Natural language (not keyword lists)
    # - Complete sentences
    # - Lowercasing (BERT is uncased)
    # - Removing excessive punctuation

    import re
    # Normalize whitespace
    text = re.sub(r'\s+', ' ', text)
    # Keep sentence structure
    text = text.strip()
    # Truncate at sentence boundary if possible
    if len(text) > max_length * 4:  # rough char estimate
        sentences = re.split(r'(?<=[.!?])\s+', text)
        truncated = []
        char_count = 0
        for sent in sentences:
            if char_count + len(sent) > max_length * 4:
                break
            truncated.append(sent)
            char_count += len(sent)
        text = ' '.join(truncated)
    return text
```

### 9.2 Chunking Strategy for RAG

```python
def chunk_for_splade(text: str,
                     chunk_size: int = 200,  # tokens
                     overlap: int = 50) -> List[str]:
    """Optimal chunking for SPLADE"""
    # SPLADE benefits from:
    # - Semantic coherence within chunks
    # - Sufficient context for term expansion
    # - Not too small (loses expansion power)
    # - Not too large (dilutes important terms)

    tokenizer = BertTokenizer.from_pretrained('bert-base-uncased')
    tokens = tokenizer.encode(text, add_special_tokens=False)

    chunks = []
    for i in range(0, len(tokens), chunk_size - overlap):
        chunk_tokens = tokens[i:i + chunk_size]
        chunk_text = tokenizer.decode(chunk_tokens, skip_special_tokens=True)
        if len(chunk_text.strip()) > 20:  # Minimum meaningful length
            chunks.append(chunk_text)
    return chunks
```

### 9.3 Hyperparameter Tuning

| Parameter | Recommended Range | Notes |
|-----------|-------------------|-------|
| **λ_q (query FLOPS)** | 0.001 - 0.01 | Lower = more expansion |
| **λ_d (doc FLOPS)** | 0.01 - 0.1 | Higher = more selective |
| **Top-k (query)** | 50 - 200 | Keep more for recall |
| **Top-k (doc)** | 100 - 500 | Documents need more terms |
| **Temperature (τ)** | 0.5 - 1.0 | For contrastive loss |
| **Learning Rate** | 1e-5 - 5e-5 | For fine-tuning |
| **Batch Size** | 16 - 64 | Depends on GPU memory |

### 9.4 Monitoring & Debugging

```python
def analyze_sparse_vector(vec: Dict[int, float],
                          tokenizer,
                          top_n: int = 20) -> Dict:
    """Analyze what terms SPLADE considers important"""
    sorted_terms = sorted(vec.items(), key=lambda x: x[1], reverse=True)

    analysis = {
        'num_terms': len(vec),
        'total_weight': sum(vec.values()),
        'top_terms': [
            {
                'token': tokenizer.decode([tid]),
                'token_id': tid,
                'weight': weight
            }
            for tid, weight in sorted_terms[:top_n]
        ],
        'weight_distribution': {
            'max': max(vec.values()),
            'mean': sum(vec.values()) / len(vec),
            'min_nonzero': min(vec.values())
        }
    }
    return analysis

# Usage
analysis = analyze_sparse_vector(query_vec, tokenizer)
print(f"Query activates {analysis['num_terms']} terms")
for term in analysis['top_terms']:
    print(f"  {term['token']:20s} : {term['weight']:.4f}")
```

