## 10. Advanced Topics

### 10.1 Query Expansion Analysis

SPLADE's expansion can be inspected:

```python
def show_expansion(original_query: str, sparse_vec: Dict,
                   tokenizer, original_tokens: List[int]):
    """Show which terms were added by SPLADE"""
    original_set = set(original_tokens)
    expanded_terms = []
    for tid, weight in sparse_vec.items():
        if tid not in original_set and tid not in [0, 101, 102, 103]:
            expanded_terms.append((tokenizer.decode([tid]), weight))

    expanded_terms.sort(key=lambda x: x[1], reverse=True)
    print(f"Original: {original_query}")
    print(f"Expanded terms ({len(expanded_terms)}):")
    for term, weight in expanded_terms[:15]:
        print(f"  + {term:20s} ({weight:.4f})")
```

### 10.2 Distillation from ColBERT

```python
def distill_colbert_to_splade(colbert_model, splade_model,
                               dataloader, optimizer, device,
                               temperature=1.0, alpha=0.5):
    """Knowledge distillation from ColBERT to SPLADE"""
    splade_model.train()
    colbert_model.eval()

    for batch in dataloader:
        queries, pos_docs, neg_docs = batch

        # ColBERT scores (teacher)
        with torch.no_grad():
            t_q = colbert_model.encode_queries(queries)
            t_pos = colbert_model.encode_docs(pos_docs)
            t_neg = colbert_model.encode_docs(neg_docs)

            t_scores_pos = colbert_model.score(t_q, t_pos)
            t_scores_neg = colbert_model.score(t_q, t_neg)
            t_scores = torch.cat([t_scores_pos, t_scores_neg], dim=1)
            t_probs = torch.softmax(t_scores / temperature, dim=1)

        # SPLADE scores (student)
        s_q = splade_model.encode_queries(queries)
        s_pos = splade_model.encode_docs(pos_docs)
        s_neg = splade_model.encode_docs(neg_docs)

        s_scores_pos = (s_q * s_pos).sum(dim=1)
        s_scores_neg = (s_q.unsqueeze(1) * s_neg).sum(dim=2)
        s_scores = torch.cat([s_scores_pos.unsqueeze(1), s_scores_neg], dim=1)
        s_log_probs = torch.log_softmax(s_scores / temperature, dim=1)

        # KL divergence loss
        kl_loss = torch.nn.functional.kl_div(s_log_probs, t_probs,
                                              reduction='batchmean')

        # SPLADE's own contrastive loss
        contrastive_loss = splade_model.contrastive_loss(s_q, s_pos, s_neg)

        # Sparsity loss
        sparsity_loss = splade_model.flops_loss(s_q, s_pos)

        # Combined loss
        loss = alpha * contrastive_loss + (1-alpha) * kl_loss * temperature**2 + sparsity_loss

        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
```

### 10.3 Quantization for Production

```python
def quantize_splade_vectors(sparse_vecs: List[Dict[int, float]],
                            bits: int = 8) -> List[Dict[int, int]]:
    """Quantize weights to reduce storage"""
    # Find global max for normalization
    all_weights = [w for vec in sparse_vecs for w in vec.values()]
    max_weight = max(all_weights)

    scale = (2**bits - 1) / max_weight

    quantized = []
    for vec in sparse_vecs:
        q_vec = {}
        for tid, weight in vec.items():
            q_weight = int(round(weight * scale))
            if q_weight > 0:
                q_vec[tid] = q_weight
        quantized.append(q_vec)

    return quantized, scale

# Dequantize at query time
def dequantize(query_vec, scale):
    return {tid: w/scale for tid, w in query_vec.items()}
```

### 10.4 Incremental Indexing

```python
class IncrementalSPLADEIndex(SPLADEIndex):
    def add_single_document(self, doc_id: str, content: str,
                            encoder: SPLADEEncoder, metadata: Dict = None):
        """Add a single document without rebuilding"""
        sparse_vec = encoder.encode_documents([content])[0]

        # Remove if exists (update case)
        if doc_id in self.doc_metadata:
            self._remove_doc(doc_id)

        # Add new
        self.doc_metadata[doc_id] = metadata or {}
        self.doc_metadata[doc_id]['content'] = content

        for token_id, weight in sparse_vec.items():
            self.index[token_id].append((doc_id, weight))

    def _remove_doc(self, doc_id: str):
        """Remove document from index"""
        # Mark as deleted (lazy deletion)
        if doc_id in self.doc_metadata:
            self.doc_metadata[doc_id]['_deleted'] = True

    def compact(self):
        """Rebuild index removing deleted docs"""
        new_index = defaultdict(list)
        for token_id, postings in self.index.items():
            for doc_id, weight in postings:
                if not self.doc_metadata.get(doc_id, {}).get('_deleted', False):
                    new_index[token_id].append((doc_id, weight))
        self.index = new_index
        # Clean metadata
        self.doc_metadata = {k: v for k, v in self.doc_metadata.items()
                            if not v.get('_deleted', False)}
```

